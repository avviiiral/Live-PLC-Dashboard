# Shared local configuration for backend and collector. Copy to .env; never commit .env.
APP_ENV=development
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:4200
TIME_ZONE=Asia/Kolkata

# Database: sqlite or postgresql
DB_ENGINE=sqlite
SQLITE_PATH=backend/db.sqlite3
POSTGRES_DB=live_plc
POSTGRES_USER=live_plc
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Backend URL reachable from the collector host
COLLECTOR_API_BASE_URL=http://127.0.0.1:8000

# local = same machine (loopback only); lan = separate factory PC
COLLECTOR_MODE=local
COLLECTOR_POLL_INTERVAL=1
COLLECTOR_RECONNECT_DELAY=3
COLLECTOR_SYNC_INTERVAL=15
COLLECTOR_QUEUE_PATH=collector/data/queue.sqlite3
# Required only for COLLECTOR_MODE=lan; one credential per collector machine
COLLECTOR_TOKEN=

LOG_LEVEL=INFO
